%% Create Product — what the Lambda does with one request.
%% Ref: docs/system.md -> "Endpoint 1 — Create Product" and "Data model"
%% 
%% PROVENANCE: solid = specified behaviour. Amber dashed = an OPEN decision.
%% The amber nodes are not questions about the spec's wording; they are
%% decisions nobody has made yet. Do not silently resolve them.

flowchart TB

  request["POST /products<br/>id: request<br/>{name, description, images[1..3], price, stock}"]

  request --> validate_payload

  validate_payload{"Required fields present,<br/>1 <= images <= 3,<br/>stock >= 0?<br/>id: validate_payload"}
  validate_payload -- "no" --> rejected["400 Bad Request<br/>id: rejected"]
  validate_payload -- "yes" --> resolve_images

  %% 'images' is specified as a count, not as a type. Whether these are S3 keys,
  %% signed URLs, or something else is unresolved.
  resolve_images["Resolve image references<br/>id: resolve_images"]
  resolve_images -- "referenced image missing" --> rejected
  resolve_images -- "all references resolve" --> assign_id

  %% The payload has no productId. This becomes the DynamoDB partition key, so
  %% the choice is not local — it constrains every later endpoint.
  assign_id["Assign productId<br/>id: assign_id"]
  assign_id --> put_item

  put_item["PutItem<br/>id: put_item<br/>partition key = productId"]

  %% Lambda retries on failure. Whether this collision is possible at all
  %% depends on assign_id — server-generated ids cannot collide across
  %% retries, caller-supplied ones can.
  put_item -- "condition failed:<br/>key already exists" --> is_duplicate
  is_duplicate{"Idempotent retry,<br/>or a real conflict?<br/>id: is_duplicate"}
  is_duplicate -. "OPEN: return existing?<br/>or 409?" .-> rejected
  is_duplicate -. "OPEN: compare payload hash?" .-> created

  put_item -- "item written" --> created["201 Created<br/>id: created"]

  classDef notspecified stroke-width:2px,stroke:#b45309,stroke-dasharray: 2 2
  class resolve_images,assign_id,is_duplicate notspecified