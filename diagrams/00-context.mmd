%% Context level — who talks to what, and which of it do we own?
%% Ref: docs/system.md -> "What the vendor sells"
%% Node IDs here are referenced from docs and the other diagrams. Treat as contract.

flowchart TB

  subgraph buyer_acct["Buyer's AWS account — not ours"]
    buyer_admin["Buyer admin<br/>id: buyer_admin"]
    buyer_app["Buyer's users<br/>id: buyer_app"]
  end

  subgraph vendor["Vendor — we build and run this"]
    vendor_saas["Multi-tenant SaaS<br/>id: vendor_saas"]
    entitlement_svc["Entitlement Service<br/>id: entitlement_svc"]
    metering_svc["Metering Batcher<br/>id: metering_svc"]
    vendor_db["Vendor DB<br/>id: vendor_db"]
  end

  subgraph third_party["Not ours"]
    marketplace["AWS Marketplace<br/>id: marketplace"]
    direct_sales["Vendor direct sales<br/>id: direct_sales"]
  end

  %% Subscription is a buyer-side act. We never get a push notification about
  %% it — this asymmetry is what forces the pull-based entitlement path.
  buyer_admin -- "Subscribe / accept offer<br/>→ entitlement grant" --> marketplace

  buyer_app -- "HTTPS app traffic<br/>→ authenticated session" --> vendor_saas
  vendor_saas -- "internal call<br/>'is this tenant entitled?'" --> entitlement_svc

  entitlement_svc -- "SigV4 POST /ResolveEntitlements<br/>→ Entitlements[]" --> marketplace

  %% Vendor DB is a MIRROR of Marketplace state, never the system of record.
  %% Losing it must be recoverable by re-resolving.
  entitlement_svc -- "write mirror<br/>account → CustomerIdentifier,<br/>dimensions, valid-from/until" --> vendor_db

  vendor_saas -- "usage events<br/>(metered dimensions only)" --> metering_svc
  metering_svc -- "SigV4 POST /BatchMeterUsage<br/>→ UsageRecordResult[]" --> marketplace

  %% Not every customer comes from Marketplace, so the entitlement and metering
  %% paths must both be no-ops rather than errors for direct customers.
  direct_sales -- "off-Marketplace customers<br/>no entitlement or metering path" --> vendor_saas

  classDef notours stroke-dasharray: 4 3
  class marketplace,direct_sales notours