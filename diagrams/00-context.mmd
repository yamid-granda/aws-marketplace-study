%% Context — the moving parts behind Create Product.
%% Ref: docs/system.md -> "Architecture" and "Open questions"
%% 
%% PROVENANCE, per docs/system.md:
%%   solid          = specified (Lambda compute, DynamoDB storage, one endpoint)
%%   dashed + amber = INFERRED or undecided — not a decision, do not build on it
%% 
%% There is no vendor, no customer, and no billing in this system. An earlier
%% revision of this file described one; it was invented and removed.

flowchart TB

  client["Catalog client<br/>id: client<br/>who calls this is unspecified"]

  api["HTTP front door<br/>id: api<br/>API Gateway? Function URL? undecided"]

  create_product["Create Product handler<br/>id: create_product"]

  products_table["DynamoDB<br/>products table<br/>id: products_table"]

  image_store["Image store<br/>id: image_store<br/>S3? bytes? undecided"]

  client -- "POST /products<br/>{name, description,<br/>images[1..3], price, stock}<br/>→ 201 Created" --> api

  api -- "invoke handler<br/>→ 201 or 400" --> create_product

  create_product -- "PutItem<br/>→ persisted item" --> products_table

  %% The spec says 'images' without saying what an image is. DynamoDB caps an
  %% item at 400 KB, so bytes cannot live in products_table.
  client -. "upload / reference images<br/>min 1, max 3" .-> image_store
  create_product -. "stores keys or signed URLs,<br/>NOT image bytes" .-> image_store

  %% Amber dashed = inferred or undecided. See docs/system.md provenance rule.
  classDef notspecified stroke-width:2px,stroke:#b45309,stroke-dasharray: 2 2
  class api,image_store notspecified