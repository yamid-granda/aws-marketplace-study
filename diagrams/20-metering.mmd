%% Container level — how does usage become revenue?
%% Ref: docs/system.md -> "Metering results are per-record, and failures are expected"
%% The important node here is record_status. Everything else follows from the
%% fact that a 200 response does NOT mean the records were accepted.

flowchart TB

  usage_event["Usage event emitted<br/>id: usage_event"] --> usage_queue["Durable queue<br/>id: usage_queue"]

  usage_queue --> metering_batcher["Batch + dedupe<br/>id: metering_batcher"]
  metering_batcher -- "group by CustomerIdentifier + Dimension,<br/>cap per batch" --> usage_store

  %% Persist BEFORE sending. Once a record is accepted we must never send it
  %% again — a re-sent record double-bills. Idempotency is the hard problem
  %% here; retry is the easy one.
  %% TODO(verify): confirm max records per BatchMeterUsage call before sizing.
  usage_store["Persist batch + idempotency key<br/>id: usage_store"]
  usage_store -- "durable, survives restart" --> batch_meter_usage

  batch_meter_usage["SigV4 POST /BatchMeterUsage<br/>id: batch_meter_usage"] --> record_status

  record_status{"Per-record Status<br/>id: record_status"}

  %% Success path.
  record_status -- "Success<br/>→ commit, delete local record" --> settled["Settled"]

  %% MUST NOT be retried. Marketplace already has this record; a retry either
  %% double-bills or is rejected forever. The single easiest thing to get wrong.
  record_status -- "DuplicateRecord<br/>→ already accepted, NEVER re-send" --> settled

  %% Permanent failures. Retrying these forever is an infinite loop that
  %% silently drops revenue. Surface them for reconciliation instead.
  record_status -- "CustomerNotSubscribed / NotEntitled<br/>→ permanent, do not retry" --> usage_dlq
  usage_dlq["Dead-letter queue<br/>id: usage_dlq"] -.-> reconcile["Manual reconciliation<br/>id: reconcile"]
  reconcile -. "vendor_charge<br/>→ Marketplace report" .-> marketplace_reports

  %% Transient failures. These are the only statuses worth backing off on.
  record_status -- "Throttled / 5xx<br/>→ exponential backoff, retry" --> usage_queue

  marketplace_reports["AWS Marketplace billing reports<br/>id: marketplace_reports"]

  classDef notours stroke-dasharray: 4 3
  class batch_meter_usage,marketplace_reports notours